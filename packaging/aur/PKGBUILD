# Maintainer: mlm-games
pkgname=floppy-warriors
pkgver=0.1.0
pkgrel=1
pkgdesc="Floppy Warriors - janky ragdoll archery roguelite"
arch=('x86_64')
url="https://github.com/mlm-games/floppy-warriors"
license=('GPL3')
depends=('alsa-lib' 'libx11' 'libxcb' 'wayland')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mlm-games/floppy-warriors/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cargo build --release
}

package() {
    install -Dm755 target/release/$pkgname "$pkgdir/usr/bin/$pkgname"
}
